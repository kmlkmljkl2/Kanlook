<Window x:Class="Kanlook.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Kanlook.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
        Title="Kanlook — Settings" Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <Border Background="{StaticResource AppBgBrush}" Padding="22,20">
        <StackPanel>
            <TextBlock Text="Settings" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Changes apply right away and are remembered between sessions."
                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,16" />

            <TextBlock Text="MAIL LIST" FontSize="10.5" FontWeight="SemiBold" Margin="0,0,0,8"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="14,12">
                <StackPanel>
                    <CheckBox IsChecked="{Binding GroupByConversation}" Cursor="Hand"
                              Foreground="{StaticResource TextPrimaryBrush}">
                        <TextBlock Text="Group mails by conversation" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </CheckBox>
                    <TextBlock Text="Show one card per conversation instead of one per mail. Cards can be expanded to reach older messages in the thread."
                               FontSize="11.5" TextWrapping="Wrap" Margin="22,4,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <Button Content="Close" Style="{StaticResource AccentButton}" HorizontalAlignment="Right"
                    Margin="0,18,0,0" IsCancel="True" IsDefault="True" Click="Close_Click" />
        </StackPanel>
    </Border>
</Window>
