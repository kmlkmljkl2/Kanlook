<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Kanlook.ViewModels"
                    xmlns:conv="clr-namespace:Kanlook.Converters"
                    xmlns:beh="clr-namespace:Kanlook.Behaviors">

    <conv:FriendlyDateConverter x:Key="FriendlyDateConverter" />
    <conv:ImportanceToVisibilityConverter x:Key="ImportanceToVisibilityConverter" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <DataTemplate DataType="{x:Type vm:MailCardViewModel}">
        <Border Style="{StaticResource MailCardBorder}" HorizontalAlignment="Stretch"
                beh:ClickBehavior.Command="{Binding SelectCommand}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Subject + unread dot -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRead}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Subject}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRead}" Value="False">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Sender + date -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding SenderName}" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding ReceivedTime, Converter={StaticResource FriendlyDateConverter}}"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" />
                </Grid>

                <!-- Snippet -->
                <TextBlock Grid.Row="2" Text="{Binding Snippet}" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="32" Margin="0,0,0,6" />

                <!-- Icon row -->
                <StackPanel Grid.Row="3" Orientation="Horizontal">
                    <TextBlock Text="📎" FontSize="11" Margin="0,0,6,0"
                               Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="⚠ High priority" FontSize="10.5" Foreground="{StaticResource HighImportanceBrush}"
                               Visibility="{Binding Importance, Converter={StaticResource ImportanceToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
