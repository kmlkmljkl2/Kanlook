<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Kanlook.ViewModels"
                    xmlns:conv="clr-namespace:Kanlook.Converters"
                    xmlns:beh="clr-namespace:Kanlook.Behaviors"
                    xmlns:dd="urn:gong-wpf-dragdrop">

    <conv:FriendlyDateConverter x:Key="FriendlyDateConverter" />
    <conv:ImportanceToBrushConverter x:Key="ImportanceToBrushConverter" />
    <conv:ImportanceToLabelConverter x:Key="ImportanceToLabelConverter" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- One older message inside a conversation tile -->
    <DataTemplate DataType="{x:Type vm:MailThreadItemViewModel}">
        <Button Style="{StaticResource ThreadItemButton}" Command="{Binding SelectCommand}"
                ToolTip="Open this message" dd:DragDrop.DragSourceIgnore="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Ellipse Grid.Row="0" Grid.Column="0" Width="6" Height="6" Margin="0,0,6,0"
                         Fill="{StaticResource AccentBrush}" VerticalAlignment="Center"
                         Visibility="{Binding IsRead, Converter={StaticResource InverseBoolToVisibility}}" />

                <!-- A reply the user sent. Never competes with the unread dot: sent mail is always read. -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="↪" FontSize="10" Margin="0,0,5,0"
                           VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                           ToolTip="Your reply"
                           Visibility="{Binding IsSent, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SenderName}" FontSize="11"
                           Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Normal" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                    <TextBlock Text="📎" FontSize="9" Margin="0,0,4,0" VerticalAlignment="Center"
                               Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding ReceivedTime, Converter={StaticResource FriendlyDateConverter}}"
                               FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Snippet}"
                           FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
            </Grid>
        </Button>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:MailCardViewModel}">
        <Border Style="{StaticResource MailCardBorder}" HorizontalAlignment="Stretch"
                beh:ClickBehavior.Command="{Binding SelectCommand}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Subject + unread dot + conversation count -->
                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                             Margin="0,0,6,0" VerticalAlignment="Center"
                             Visibility="{Binding IsRead, Converter={StaticResource InverseBoolToVisibility}}" />

                    <TextBlock Grid.Column="1" Text="{Binding Subject}"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Normal" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRead}" Value="False">
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Conversation size, like Outlook's message count -->
                    <Border Grid.Column="2" Margin="6,0,0,0" Padding="6,1" CornerRadius="9"
                            Background="{StaticResource AppBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" VerticalAlignment="Center"
                            ToolTip="Messages in this conversation"
                            Visibility="{Binding IsConversation, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding MessageCount}" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </Border>
                </Grid>

                <!-- Sender + date -->
                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding SenderName}" FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding ReceivedTime, Converter={StaticResource FriendlyDateConverter}}"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="8,0,0,0" />
                </Grid>

                <!-- Snippet -->
                <TextBlock Grid.Row="2" Text="{Binding Snippet}" FontSize="11.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                           MaxHeight="32" Margin="0,0,0,6" />

                <!-- Outlook categories -->
                <ItemsControl Grid.Row="3" ItemsSource="{Binding Categories}" Margin="0,0,0,4"
                              Visibility="{Binding HasCategories, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Padding="7,2" Margin="0,0,4,4"
                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                    ToolTip="Outlook category">
                                <TextBlock Text="{Binding Name}" FontSize="10" Foreground="White" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The user's note: shown as a block, swapped for an editor while being changed -->
                <Grid Grid.Row="4" Margin="0,0,0,2">
                    <Button Style="{StaticResource CardNoteButton}" Command="{Binding BeginEditCommentCommand}"
                            ToolTip="Edit note" dd:DragDrop.DragSourceIgnore="True">
                        <TextBlock Text="{Binding Comment}" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Button>

                    <StackPanel Visibility="{Binding IsEditingComment, Converter={StaticResource BoolToVisibility}}"
                                dd:DragDrop.DragSourceIgnore="True">
                        <TextBox Style="{StaticResource CardNoteTextBox}"
                                 Text="{Binding CommentDraft, UpdateSourceTrigger=PropertyChanged}"
                                 beh:FocusBehavior.FocusWhenVisible="True"
                                 ToolTip="Ctrl+Enter saves, Esc discards">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Modifiers="Control" Command="{Binding CommitCommentCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding CancelEditCommentCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Remove" Style="{StaticResource FlatButton}"
                                    FontSize="11" Padding="4,2" ToolTip="Delete this note"
                                    Command="{Binding RemoveCommentCommand}"
                                    Visibility="{Binding HasComment, Converter={StaticResource BoolToVisibility}}" />
                            <Button Grid.Column="2" Content="Save" Style="{StaticResource AccentButton}"
                                    FontSize="11" Padding="10,4" Command="{Binding CommitCommentCommand}" />
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Icon row + actions -->
                <Grid Grid.Row="5" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📎" FontSize="11" Margin="0,0,6,0"
                                   Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Text="⚑" FontSize="12"
                                   Foreground="{Binding Importance, Converter={StaticResource ImportanceToBrushConverter}}"
                                   ToolTip="{Binding Importance, Converter={StaticResource ImportanceToLabelConverter}}" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Style="{StaticResource CardPriorityButton}"
                                Command="{Binding TogglePriorityCommand}" ToolTip="{Binding PriorityToolTip}"
                                dd:DragDrop.DragSourceIgnore="True">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="☆" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsHighPriority}" Value="True">
                                                <Setter Property="Text" Value="★" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                        <Button Style="{StaticResource CardNoteToggleButton}" Content="💬"
                                Command="{Binding BeginEditCommentCommand}" ToolTip="{Binding CommentToolTip}"
                                dd:DragDrop.DragSourceIgnore="True" />
                        <Button Style="{StaticResource CardActionButton}" Content="{Binding ReadToggleGlyph}"
                                Command="{Binding ToggleReadCommand}" ToolTip="{Binding ReadToggleToolTip}"
                                dd:DragDrop.DragSourceIgnore="True" />
                        <Button Style="{StaticResource CardActionButton}" Content="🗑"
                                Command="{Binding DeleteCommand}" ToolTip="{Binding DeleteToolTip}"
                                dd:DragDrop.DragSourceIgnore="True" />
                    </StackPanel>
                </Grid>

                <!-- Conversation expander + older messages -->
                <StackPanel Grid.Row="6"
                            Visibility="{Binding IsConversation, Converter={StaticResource BoolToVisibility}}">
                    <Button Style="{StaticResource ThreadExpanderButton}" Command="{Binding ToggleExpandedCommand}"
                            dd:DragDrop.DragSourceIgnore="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="9" Margin="0,0,5,0" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="▶" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Text" Value="▼" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding ExpandLabel}" FontSize="11" VerticalAlignment="Center"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Button>

                    <ItemsControl ItemsSource="{Binding OlderMessages}" Margin="6,2,0,0"
                                  HorizontalContentAlignment="Stretch"
                                  Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0"
                                        Padding="7,0,0,0">
                                    <ItemsPresenter />
                                </Border>
                            </ControlTemplate>
                        </ItemsControl.Template>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

</ResourceDictionary>
