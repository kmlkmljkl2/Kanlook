<UserControl x:Class="Kanlook.Views.SharedFolderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kanlook.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SharedFolderViewModel}">

    <Grid Background="{DynamicResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="26,20,26,6" MaxWidth="660" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
                <Path Data="{StaticResource Icon.SharedFolder}" Style="{StaticResource Icon}"
                      Width="18" Height="18" Margin="0,0,10,0" Stroke="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding FolderName}" Style="{StaticResource PageTitle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,6,0,10"
                       Text="Shared mailbox — mail is listed by date. Columns and drag-and-drop are available in your own folders; notes and priority work here too." />
        </StackPanel>

        <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Cards}" Margin="26,0,26,20" HorizontalContentAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel MaxWidth="660" HorizontalAlignment="Left" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding Cards.Count, Converter={StaticResource ZeroCountToVisibilityConverter}}">
                <Path Data="{StaticResource Icon.Inbox}" Style="{StaticResource Icon}" Width="34" Height="34"
                      Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.3" />
                <TextBlock Text="This folder is empty" Style="{StaticResource PageSubtitle}"
                           FontSize="14" Margin="0,14,0,0" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
