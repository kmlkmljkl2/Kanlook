<UserControl x:Class="Kanlook.Views.KanbanBoardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kanlook.ViewModels"
             xmlns:dd="urn:gong-wpf-dragdrop"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:KanbanBoardViewModel}">

    <Grid Background="{StaticResource AppBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,22,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding FolderName}" FontSize="21" FontWeight="Bold"
                       VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}" />

            <TextBlock Grid.Column="1" Text="{Binding IndexingStatus}" FontSize="11.5" Margin="14,0,14,0"
                       VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding IndexingStatus, Converter={StaticResource NullToVisibilityConverter}}" />

            <!-- Search: subject, sender, body, categories and attachment contents -->
            <Border Grid.Column="2" Width="260" Margin="0,0,10,0" CornerRadius="8" Padding="10,0"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" VerticalAlignment="Center"
                               Margin="0,0,6,0" Foreground="{StaticResource TextSecondaryBrush}" />

                    <Grid Grid.Column="1">
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 Style="{StaticResource SearchTextBox}" />
                        <TextBlock Text="Search mail and attachments" FontSize="12" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding SearchText, Converter={StaticResource EmptyStringToVisibilityConverter}}" />
                    </Grid>

                    <Button Grid.Column="2" Content="✕" Style="{StaticResource FlatButton}" FontSize="10"
                            Padding="4" ToolTip="Clear search" Command="{Binding ClearSearchCommand}"
                            Visibility="{Binding SearchText, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />
                </Grid>
            </Border>

            <Button Grid.Column="3" Style="{StaticResource AccentButton}" Content="+ Add column"
                    Command="{Binding AddColumnCommand}" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="BoardRoot" ItemsSource="{Binding Columns}" Margin="28,0,28,24">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:KanbanColumnViewModel}">
                        <Border Width="270" Margin="0,0,16,0" Background="{StaticResource SurfaceBrush}"
                                CornerRadius="12" VerticalAlignment="Top">
                            <Border.Effect>
                                <DropShadowEffect Color="#1E2233" Opacity="0.05" BlurRadius="14" ShadowDepth="3" Direction="270" />
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Column header -->
                                <Border Grid.Row="0" CornerRadius="12,12,0,0" Padding="12,10">
                                    <Border.Background>
                                        <Binding Path="ColorHex" Converter="{StaticResource HexToBrushConverter}" />
                                    </Border.Background>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsEditingName, Converter={StaticResource InverseBoolToVisibility}}"
                                                       MouseLeftButtonDown="ColumnTitle_MouseLeftButtonDown" />
                                            <TextBox x:Name="NameEditBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource InlineEditTextBox}"
                                                     Foreground="White" BorderBrush="White"
                                                     Visibility="{Binding IsEditingName, Converter={StaticResource BoolToVisibility}}"
                                                     LostFocus="NameEditBox_LostFocus"
                                                     KeyDown="NameEditBox_KeyDown"
                                                     IsVisibleChanged="NameEditBox_IsVisibleChanged" />
                                        </Grid>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button ToolTip="Set as the target for new/incoming mail"
                                                    Style="{StaticResource FlatButton}" FontSize="12"
                                                    Command="{Binding SetAsDefaultCommand}">
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="☆" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDefaultTarget}" Value="True">
                                                                    <Setter Property="Text" Value="★" />
                                                                    <Setter Property="Foreground" Value="Gold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>
                                            <Button x:Name="ColorSwatchButton" ToolTip="Change column color"
                                                    Style="{StaticResource FlatButton}"
                                                    Command="{Binding ToggleColorPickerCommand}">
                                                <Ellipse Width="12" Height="12" Stroke="White" StrokeThickness="1">
                                                    <Ellipse.Fill>
                                                        <Binding Path="ColorHex" Converter="{StaticResource HexToBrushConverter}" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Button>
                                            <Button Content="◀" ToolTip="Move left" Style="{StaticResource FlatButton}"
                                                    Foreground="White" FontSize="10" Command="{Binding MoveLeftCommand}" />
                                            <Button Content="▶" ToolTip="Move right" Style="{StaticResource FlatButton}"
                                                    Foreground="White" FontSize="10" Command="{Binding MoveRightCommand}" />
                                            <Button Content="✕" ToolTip="Remove column" Style="{StaticResource FlatButton}"
                                                    Foreground="White" FontSize="10" Command="{Binding RemoveCommand}" />
                                        </StackPanel>

                                        <Popup Grid.Column="0" IsOpen="{Binding IsColorPickerOpen}"
                                               PlacementTarget="{Binding ElementName=ColorSwatchButton}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,0,0">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#1E2233" Opacity="0.18" BlurRadius="12" ShadowDepth="3" Direction="270" />
                                                </Border.Effect>
                                                <UniformGrid Columns="4" Rows="2" Width="136">
                                                    <Button Width="28" Height="28" Margin="3" Cursor="Hand"
                                                            Command="{Binding SetColorCommand}" CommandParameter="#5B8DEF">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Ellipse Fill="#5B8DEF" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="3" Cursor="Hand"
                                                            Command="{Binding SetColorCommand}" CommandParameter="#F2A93B">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Ellipse Fill="#F2A93B" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="3" Cursor="Hand"
                                                            Command="{Binding SetColorCommand}" CommandParameter="#B87CE0">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Ellipse Fill="#B87CE0" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="3" Cursor="Hand"
                                                            Command="{Binding SetColorCommand}" CommandParameter="#4CB782">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Ellipse Fill="#4CB782" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="3" Cursor="Hand"
                                                            Command="{Binding SetColorCommand}" CommandParameter="#E5566B">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Ellipse Fill="#E5566B" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="3" Cursor="Hand"
                                                            Command="{Binding SetColorCommand}" CommandParameter="#2FB6C4">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Ellipse Fill="#2FB6C4" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="3" Cursor="Hand"
                                                            Command="{Binding SetColorCommand}" CommandParameter="#8C93A6">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Ellipse Fill="#8C93A6" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button Width="28" Height="28" Margin="3" Cursor="Hand"
                                                            Command="{Binding SetColorCommand}" CommandParameter="#D6558C">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Ellipse Fill="#D6558C" Stroke="{StaticResource BorderBrush}" StrokeThickness="1" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </UniformGrid>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </Border>

                                <!-- Cards -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="640">
                                    <ItemsControl ItemsSource="{Binding Cards}" Margin="10" MinHeight="60"
                                                  Background="Transparent"
                                                  HorizontalContentAlignment="Stretch"
                                                  VerticalAlignment="Stretch"
                                                  dd:DragDrop.IsDragSource="True"
                                                  dd:DragDrop.IsDropTarget="True"
                                                  dd:DragDrop.UseDefaultDragAdorner="True"
                                                  dd:DragDrop.DragHandler="{Binding Board}"
                                                  dd:DragDrop.DropHandler="{Binding Board}" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
