<UserControl x:Class="Kanlook.Views.FolderTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kanlook.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Grid Background="{StaticResource SidebarBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,18,10,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="📮" FontSize="18" Margin="0,0,8,0" />
                <TextBlock Text="Kanlook" FontSize="17" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1" Content="⚙" FontSize="15" ToolTip="Settings"
                    VerticalAlignment="Center" Click="SettingsButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                        <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>

        <TreeView Grid.Row="1"
                  ItemsSource="{Binding RootFolders}"
                  Style="{StaticResource SidebarTreeView}"
                  ItemContainerStyle="{StaticResource SidebarTreeViewItem}"
                  SelectedItemChanged="TreeView_OnSelectedItemChanged">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="📁" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSharedMailbox}" Value="True">
                                            <Setter Property="Text" Value="👥" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{StaticResource SidebarTextBrush}" TextTrimming="CharacterEllipsis" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                            <Button Content="▲" ToolTip="Move up" FontSize="8" Padding="3"
                                    Foreground="{StaticResource SidebarTextMutedBrush}"
                                    Command="{Binding MoveUpCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Setter Property="Foreground" Value="{StaticResource SidebarTextMutedBrush}" />
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="▼" ToolTip="Move down" FontSize="8" Padding="3"
                                    Command="{Binding MoveDownCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource FlatButton}">
                                        <Setter Property="Foreground" Value="{StaticResource SidebarTextMutedBrush}" />
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
