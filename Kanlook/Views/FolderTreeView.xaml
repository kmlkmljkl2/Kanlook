<UserControl x:Class="Kanlook.Views.FolderTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Kanlook.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <UserControl.Resources>
        <!-- Sidebar buttons sit on a dark panel in both themes, so they carry their own colours. -->
        <Style x:Key="SidebarIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMutedBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource SidebarBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,10,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Path Data="{StaticResource Icon.Inbox}" Style="{StaticResource Icon}" Width="19" Height="19"
                      Margin="0,0,9,0" Stroke="{DynamicResource SidebarSelectedBrush}" StrokeThickness="1.9" />
                <TextBlock Text="Kanlook" FontSize="16" FontWeight="SemiBold" Foreground="White"
                           VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1" Style="{StaticResource SidebarIconButton}" ToolTip="Settings"
                    VerticalAlignment="Center" Click="SettingsButton_Click">
                <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource Icon}" Width="16" Height="16" />
            </Button>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{DynamicResource SidebarBorderBrush}" Margin="0,0,0,6" />

        <TextBlock Grid.Row="2" Text="Reading your mailboxes…" FontSize="12" Margin="18,10,18,0"
                   VerticalAlignment="Top" Foreground="{DynamicResource SidebarTextMutedBrush}"
                   Visibility="{Binding IsLoadingFolders, Converter={StaticResource BoolToVisibility}}" />

        <TreeView Grid.Row="2"
                  ItemsSource="{Binding RootFolders}"
                  Style="{StaticResource SidebarTreeView}"
                  ItemContainerStyle="{StaticResource SidebarTreeViewItem}"
                  SelectedItemChanged="TreeView_OnSelectedItemChanged">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <!-- The move buttons stay out of sight until the row is hovered -->
                    <Grid x:Name="Row" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- The "Loading…" stand-in of a folder not opened yet isn't a folder -->
                        <Path Grid.Column="0" Width="14" Height="14"
                              Margin="0,0,8,0" Stroke="{DynamicResource SidebarTextMutedBrush}"
                              Visibility="{Binding IsPlaceholder, Converter={StaticResource InverseBoolToVisibility}}">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource Icon}">
                                    <Setter Property="Data" Value="{StaticResource Icon.Folder}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSharedMailbox}" Value="True">
                                            <Setter Property="Data" Value="{StaticResource Icon.SharedFolder}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>

                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TreeViewItem}}"
                                   TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                            <Setter Property="FontStyle" Value="Italic" />
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource SidebarTextMutedBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0"
                                    Visibility="{Binding IsMouseOver, ElementName=Row, Converter={StaticResource BoolToVisibility}}">
                            <Button Style="{StaticResource SidebarIconButton}" Width="20" Height="20"
                                    ToolTip="Move up" Command="{Binding MoveUpCommand}">
                                <Path Data="{StaticResource Icon.ChevronUp}" Style="{StaticResource Icon}"
                                      Width="10" Height="10" />
                            </Button>
                            <Button Style="{StaticResource SidebarIconButton}" Width="20" Height="20"
                                    ToolTip="Move down" Command="{Binding MoveDownCommand}">
                                <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource Icon}"
                                      Width="10" Height="10" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </Grid>
</UserControl>
