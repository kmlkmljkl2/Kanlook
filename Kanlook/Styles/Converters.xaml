<!-- Every value converter the app binds through, in one place so views don't declare their own. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Kanlook.Converters">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <conv:HexToBrushConverter x:Key="HexToBrushConverter" />
    <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <conv:NullToInverseVisibilityConverter x:Key="NullToInverseVisibilityConverter" />
    <conv:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountToVisibilityConverter" />
    <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVisibilityConverter" />
    <conv:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />
    <conv:FriendlyDateConverter x:Key="FriendlyDateConverter" />
    <conv:ImportanceToLabelConverter x:Key="ImportanceToLabelConverter" />

</ResourceDictionary>
