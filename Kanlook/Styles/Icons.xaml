    <StreamGeometry x:Key="Icon.ReplyAll">M 8,7 L 3,12 L 8,17 M 13.5,7 L 8.5,12 L 13.5,17 M 8.5,12 H 16 A 5,5 0 0 1 21,17 V 19.5</StreamGeometry>
