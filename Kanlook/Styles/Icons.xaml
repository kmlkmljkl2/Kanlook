<!--
    Line-art icon geometries, all drawn on a 24x24 grid so they share a weight and can be scaled by
    the Icon styles in Controls.xaml. Stroked unless the name says Filled - a filled icon reads as
    "on" beside its outlined twin, which is how the priority star shows its state.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Chrome -->
    <StreamGeometry x:Key="Icon.Search">M 10.5,4 A 6.5,6.5 0 1 0 10.5,17 A 6.5,6.5 0 1 0 10.5,4 Z M 15.3,15.3 L 20,20</StreamGeometry>
    <StreamGeometry x:Key="Icon.Close">M 6,6 L 18,18 M 18,6 L 6,18</StreamGeometry>
    <StreamGeometry x:Key="Icon.Plus">M 12,5 V 19 M 5,12 H 19</StreamGeometry>
    <StreamGeometry x:Key="Icon.Settings">M 12,9 A 3,3 0 1 0 12,15 A 3,3 0 1 0 12,9 Z M 19.4,15 a 1.65,1.65 0 0 0 0.33,1.82 l 0.06,0.06 a 2,2 0 0 1 0,2.83 2,2 0 0 1 -2.83,0 l -0.06,-0.06 a 1.65,1.65 0 0 0 -1.82,-0.33 1.65,1.65 0 0 0 -1,1.51 V 21 a 2,2 0 0 1 -4,0 v -0.09 A 1.65,1.65 0 0 0 9,19.4 a 1.65,1.65 0 0 0 -1.82,0.33 l -0.06,0.06 a 2,2 0 0 1 -2.83,0 2,2 0 0 1 0,-2.83 l 0.06,-0.06 a 1.65,1.65 0 0 0 0.33,-1.82 1.65,1.65 0 0 0 -1.51,-1 H 3 a 2,2 0 0 1 0,-4 h 0.09 A 1.65,1.65 0 0 0 4.6,9 a 1.65,1.65 0 0 0 -0.33,-1.82 l -0.06,-0.06 a 2,2 0 0 1 0,-2.83 2,2 0 0 1 2.83,0 l 0.06,0.06 a 1.65,1.65 0 0 0 1.82,0.33 H 9 a 1.65,1.65 0 0 0 1,-1.51 V 3 a 2,2 0 0 1 4,0 v 0.09 a 1.65,1.65 0 0 0 1,1.51 1.65,1.65 0 0 0 1.82,-0.33 l 0.06,-0.06 a 2,2 0 0 1 2.83,0 2,2 0 0 1 0,2.83 l -0.06,0.06 a 1.65,1.65 0 0 0 -0.33,1.82 V 9 a 1.65,1.65 0 0 0 1.51,1 H 21 a 2,2 0 0 1 0,4 h -0.09 a 1.65,1.65 0 0 0 -1.51,1 Z</StreamGeometry>
    <StreamGeometry x:Key="Icon.MoreFilled">M 5.6,10.4 A 1.6,1.6 0 1 0 5.6,13.6 A 1.6,1.6 0 1 0 5.6,10.4 Z M 12,10.4 A 1.6,1.6 0 1 0 12,13.6 A 1.6,1.6 0 1 0 12,10.4 Z M 18.4,10.4 A 1.6,1.6 0 1 0 18.4,13.6 A 1.6,1.6 0 1 0 18.4,10.4 Z</StreamGeometry>

