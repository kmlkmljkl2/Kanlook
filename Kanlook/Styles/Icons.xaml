    <StreamGeometry x:Key="Icon.Star">M 12,2.8 L 15.1,9.1 L 22,10.1 L 17,15 L 18.2,21.9 L 12,18.6 L 5.8,21.9 L 7,15 L 2,10.1 L 8.9,9.1 Z</StreamGeometry>

