    <StreamGeometry x:Key="Icon.ChevronLeft">M 15,4.5 L 8,12 L 15,19.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronRight">M 9,4.5 L 16,12 L 9,19.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronUp">M 4.5,15 L 12,8 L 19.5,15</StreamGeometry>
    <StreamGeometry x:Key="Icon.ChevronDown">M 4.5,9 L 12,16 L 19.5,9</StreamGeometry>
