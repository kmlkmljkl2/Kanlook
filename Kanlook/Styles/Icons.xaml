    <StreamGeometry x:Key="Icon.Document">M 14,3 H 6.5 V 21 H 17.5 V 6.5 Z M 14,3 V 6.5 H 17.5</StreamGeometry>
    <StreamGeometry x:Key="Icon.Flag">M 5.5,3 V 21 M 5.5,4.5 H 19 L 15.8,9 L 19,13.5 H 5.5</StreamGeometry>
