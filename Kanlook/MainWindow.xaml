<Window x:Class="Kanlook.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Kanlook.ViewModels"
        xmlns:views="clr-namespace:Kanlook.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Kanlook — Outlook Kanban" Height="820" Width="1360"
        MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:KanbanBoardViewModel}">
            <views:KanbanBoardView />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding ClosePreviewCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource DangerBrush}" Padding="16,10"
                Visibility="{Binding ConnectionErrorMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Path Grid.Column="0" Data="{StaticResource Icon.Alert}" Style="{StaticResource Icon}"
                      Width="16" Height="16" Margin="0,0,11,0" VerticalAlignment="Top" Stroke="White" />

                <TextBlock Grid.Column="1" Text="{Binding ConnectionErrorMessage}" Foreground="White"
                           TextWrapping="Wrap" FontSize="12.5" VerticalAlignment="Center" />

                <Button Grid.Column="2" Style="{StaticResource FlatButton}" Foreground="White" Padding="5"
                        Margin="10,0,0,0" VerticalAlignment="Top" ToolTip="Dismiss"
                        Command="{Binding DismissErrorCommand}">
                    <Path Data="{StaticResource Icon.Close}" Style="{StaticResource Icon}" Width="12" Height="12" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SidebarWidth, Mode=TwoWay}" MinWidth="170" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding PreviewColumnWidth, Mode=TwoWay}" MinWidth="0" MaxWidth="720" />
            </Grid.ColumnDefinitions>

            <views:FolderTreeView Grid.Column="0" />

            <!-- Drag to resize the folder list. Its width is remembered between sessions. -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ShowsPreview="False" Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns" />

            <Border Grid.Column="2" Background="{DynamicResource AppBgBrush}">
                <Grid>
                    <ContentControl Content="{Binding CurrentContent}" />

                    <!-- Nothing picked yet. Beats opening onto an empty grey rectangle. -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                                Visibility="{Binding CurrentContent, Converter={StaticResource NullToInverseVisibilityConverter}}">
                        <Path Data="{StaticResource Icon.Inbox}" Style="{StaticResource Icon}" Width="44" Height="44"
                              Stroke="{DynamicResource BorderStrongBrush}" StrokeThickness="1.2" />
                        <TextBlock Text="Pick a mail folder" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0"
                                   HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,7,0,0" TextAlignment="Center"
                                   Text="Choose a folder on the left and its mail lands on a board you can drag between columns." />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" ShowsPreview="False" Cursor="SizeWE"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Visibility="{Binding Preview, Converter={StaticResource NullToVisibilityConverter}}" />

            <Border Grid.Column="4"
                    Visibility="{Binding Preview, Converter={StaticResource NullToVisibilityConverter}}">
                <views:PreviewPaneView DataContext="{Binding Preview}" />
            </Border>
        </Grid>
    </Grid>
</Window>
